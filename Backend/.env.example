# UniSphere Backend Environment Variables Template
PORT=5000
MONGO_URI=mongodb+srv://user:password@cluster0.example.mongodb.net/unisphere
JWT_SECRET=your_jwt_secret_key_here
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Client URL for CORS (In production, set to your Vercel frontend URL, e.g., https://your-frontend.vercel.app)
CLIENT_URL=http://localhost:5173

# Environment setting (development or production)
NODE_ENV=development
